# Send only the website sources and its build/server configuration to Docker.
**
!Dockerfile
!package.json
!package-lock.json
!apps/
apps/**
!apps/web/
apps/web/**
!apps/web/package.json
!apps/web/next.config.ts
!apps/web/tsconfig.json
!apps/web/tsconfig.test.json
!apps/web/app/
!apps/web/app/**
!apps/web/components/
!apps/web/components/**
!apps/web/lib/
!apps/web/lib/**
!apps/web/public/
!apps/web/public/**
!apps/web/tests/
!apps/web/tests/**
!docker/
docker/**
!docker/nginx.conf
!docker/security-headers.conf

# These stay excluded even if placed inside an allowed source directory.
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules
**/.next
**/.test-build
**/.venv
**/venv
**/__pycache__
**/*.tsbuildinfo
**/.DS_Store
